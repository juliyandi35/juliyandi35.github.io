# Optional. Used only by scripts/build-manifest.mjs at build time to raise the
# GitHub API rate limit (unauthenticated requests are capped at 60/hour, which
# is not enough to refresh the manifest for all 301 repositories in one run).
# A fine-grained "public repositories: read-only" token is sufficient.
#
# This value is never read by client code, never bundled into the site, and
# must never be committed. If it is absent or invalid, the build silently
# falls back to the committed data/manifest.json cache.
GITHUB_TOKEN=

# GitHub username the manifest is generated from.
GITHUB_USERNAME=juliyandi35
